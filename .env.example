# ══════════════════════════════════════════════════════════════════════════════
# .env.example — copy this file to .env and fill in your real values
# NEVER commit .env to git — it is listed in .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq LLM API ───────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── MySQL Database ─────────────────────────────────────────────────────────────
# For local development you can use SQLite (no DB_ vars needed — see database.py)
# For production, fill in your MySQL credentials below
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dot_matcher
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Admin account ──────────────────────────────────────────────────────────────
# Password for the built-in admin user (hashed with bcrypt at first login)
# ADMIN_PASSWORD=change_me_before_deploy
