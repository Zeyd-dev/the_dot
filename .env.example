# ══════════════════════════════════════════════════════════════════════════════
# .env.example — copy this file to .env and fill in your real values
# NEVER commit .env to git — it is listed in .gitignore
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq LLM API ───────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── Supabase Database ──────────────────────────────────────────────────────────
# Supabase → Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# ── Admin account ──────────────────────────────────────────────────────────────
# Password for the built-in admin user (hashed with bcrypt at first login)
ADMIN_PASSWORD=change_me_before_deploy
